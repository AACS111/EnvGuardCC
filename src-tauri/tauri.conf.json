{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvGuardCC",
  "mainBinaryName": "EnvGuardCC",
  "version": "../package.json",
  "identifier": "io.github.aacs111.envguardcc",
  "build": { "frontendDist": "http://127.0.0.1:3030" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["../public/envguardcc-icon.png", "../desktop/envguardcc.ico"],
    "resources": { "../node_modules/.checkcc-tauri-backend/": "backend/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
