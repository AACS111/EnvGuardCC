# EnvGuardCC 的 Git 忽略规则，用于排除依赖、构建产物、环境变量、本地调试文件和系统临时文件。
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/src-tauri/target/
/src-tauri/gen/
/.checkcc-desktop-build-source/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
/logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example
!.env.*.example
.npmrc.local

# local agent/editor settings
/.codex/
/.agents/

# vercel
.vercel

# typescript
*.tsbuildinfo

# local overrides
*.local

# Offline license issuer: private signing material never belongs in a release or Git.
/.checkcc-license-issuer/

# Local-only verification scripts: not shipped with the repo.
/scripts/check-net-core.mjs
/scripts/check-net-core-view.mjs
/scripts/check-exit-history.mjs
/scripts/check-kernel-host.mjs
/scripts/check-browser-catalog.mjs
/scripts/check-environment-profile.mjs
